# ============ 向量模型 (Embedding) ============
# 默认：BAAI/bge-m3  多语言 + 学术友好，1024 维（推荐）
# 纯中文可选：BAAI/bge-large-zh-v1.5
# 最轻量兜底：all-MiniLM-L6-v2 （仅英文，不推荐）
# 首次会下载 ~2.3GB 到 HF cache；换模型后务必在 UI 点"重建全库向量"。
SCHOLAR_ST_MODEL=BAAI/bge-m3

# ============ LLM 选择 ============
SCHOLAR_LLM_PROVIDER=local
SCHOLAR_OLLAMA_MODEL=qwen2.5:3b
SCHOLAR_GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=xxx(gemini api key)

# Gemini 出网模式（auto / direct / proxy_env）
# auto    : 先直连，失败再尝试系统代理（推荐）
# direct  : 始终直连
# proxy_env : 读系统代理（HTTP_PROXY / HTTPS_PROXY）
SCHOLAR_GEMINI_NETWORK_MODE=auto

# 若走系统代理，建议显式设置，避免本地服务被代理
# NO_PROXY=127.0.0.1,localhost


# ============ PDF OCR ============
# auto   : 逐页判定质量，差页才跑 OCR（推荐，速度/效果平衡）
# force  : 每页都跑 OCR（最稳但最慢，适合大量扫描版）
# off    : 只用 PDF 原生文本层
SCHOLAR_OCR_ENABLED=force

# OCR 语种（遵循 Tesseract 的 lang code，多语种用 + 连接）
# 例：chi_sim+eng / chi_tra+eng / eng / jpn+eng
SCHOLAR_OCR_LANG=chi_sim+eng

# OCR 放大倍率（越大越清晰但越慢；1.5~3.0 都合理）
SCHOLAR_OCR_ZOOM=2.0

# auto 模式下的页面质量阈值（低于它就 OCR，0~1）
SCHOLAR_OCR_MIN_QUALITY=0.55

# 如果 Tesseract 已经加到 PATH，这里留空即可，程序会自动找到。
# 若没有，请按你的系统填下面对应示例中的一条：
#   Windows 示例：C:\Program Files\Tesseract-OCR\tesseract.exe
#   macOS (Homebrew)：/opt/homebrew/bin/tesseract        # M 系列
#                    /usr/local/bin/tesseract           # Intel
#   Linux：/usr/bin/tesseract
SCHOLAR_TESSERACT_CMD=


# ============ MinerU (公式/表格/版面 专用解析器, 可选) ============
# 仅当你在 PaperDetail → 重新识别 → MinerU 时才会被调用。
# 安装(推荐单独 conda env):
#    conda create -n mineru python=3.10 -y
#    conda activate mineru
#    pip install -U "mineru[core]"
#    mineru --help   # 验证能否跑
# 然后把可执行路径填到下面；不填的话会走 PATH 里的 mineru。
#   Windows 示例：C:\ProgramData\miniconda3\envs\mineru\Scripts\mineru.exe
#   macOS 示例：  /opt/homebrew/Caskroom/miniconda/base/envs/mineru/bin/mineru
#   Linux 示例：  /home/<you>/miniconda3/envs/mineru/bin/mineru
# SCHOLAR_MINERU_CMD=
# 识别语种：ch / en / korean / japan / ...
SCHOLAR_MINERU_LANG=ch
# 后端：pipeline（最稳，CPU/GPU 均可） / vlm-transformers（需显存 >= 8GB）
SCHOLAR_MINERU_BACKEND=pipeline
# 超时秒数（大论文 + CPU 可能要 10 分钟以上）
SCHOLAR_MINERU_TIMEOUT=900